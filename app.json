{
  "expo": {
    "name": "OPX Cold Wallet",
    "slug": "opx-wallet-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "opxwallet",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0B1220"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.opx.coldwallet",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "org.opx.coldwallet",
      "adaptiveIcon": {
        "backgroundColor": "#0B1220"
      },
      "permissions": []
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "replace-with-your-eas-project-id"
      }
    }
  }
}
